# --- Server ---
HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:4200
SQLITE_PATH=./data/panel.db
TZ=Asia/Tehran

# Cache MikroTik user/profile lists (invalidate on any router write)
MIKROTIK_CACHE_TTL=30s

# --- Auth (JWT) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# First bootstrap admin (created only if no admins exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- MikroTik (api-ssl) ---
# true = in-memory fake router (dev)
MIKROTIK_FAKE=true
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8729
MIKROTIK_USERNAME=api-panel
MIKROTIK_PASSWORD=
# true = skip TLS verify (dev only)
MIKROTIK_TLS_INSECURE=false
# Timeout per RouterOS command
MIKROTIK_TIMEOUT=10s

# Default profile name on router (must exist in User Manager)
DEFAULT_PROFILE=profile-open-2M-30d

# --- Naming ---
# Prefix separator: pattern = slug + separator (e.g. ali- or ali_)
USERNAME_PREFIX_SEPARATOR=_

# Max length for local part (prefix + separator + local <= 32 for safety)
USERNAME_LOCAL_MAX_LEN=24

# --- Connection bundle (manager shares with end customer) ---
OPENVPN_DOWNLOAD_URL=http://dl.nimbaha.info/dl/
OPENVPN_KEY_PASSWORD=
L2TP_IPSEC_SECRET=
L2TP_SERVER=
# Path to .ovpn template on server (placeholders: {{username}}, {{password}}, ...)
OPENVPN_TEMPLATE_PATH=../config/client-template.ovpn
